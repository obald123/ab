# Rendered at container start by the nginx image: ${VARIABLES} are replaced
# from the environment (only variables that are set — nginx's own $uri etc.
# are left alone). Mirrors what vercel.json did on Vercel.

# Keep the original scheme when a load balancer terminates TLS in front.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 8080;
    server_name ${SERVER_NAME};
    root /usr/share/nginx/html;
    server_tokens off;

    # The public site only sends the contact form; nothing large.
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Admin and sign-in endpoints are not needed by the public site, so they
    # are not reachable through its domain at all — only through the CMS's.
    location ^~ /api/v1/admin/ { return 404; }
    location ^~ /api/v1/auth/  { return 404; }

    # Same-origin API: the browser talks to this site, nginx to the backend.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
    }

    # Fingerprinted build output: cache for a year.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything else (index.html, service worker, manifest) is revalidated so
    # a deploy reaches visitors immediately. Unknown paths are app routes.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
